gamma = 0,
max_depth = 6,
min_child_weight = 1,
subsample = 1,
colsample_bytree =1,
eval_metric = "auc",
eval_metric = "aucpr",
eval_metric = "logloss"
)
xgb1 <- xgb.train(
params = params,
data = dtrain,
nrounds = 89,
evals = list(val = dtest, train = dtrain),
